# Frontend configuration allowed for the public artifact.
PAW_CLOUD_ENV_ID=paw-diary-d8g3p4tlsb305221d
PAW_CLOUD_PUBLISHABLE_KEY=
PAW_CLOUD_ENABLED=false
# Management secrets: read existing TENCENTCLOUD_FUJI_SECRET_ID/KEY from process env.
# Never put management keys in frontend config or this file.

# Public feature switch only (contains no API credential).
PAW_AI_ENABLED=false
# Server-only AI settings. Deploy reads SILICONFLOW_API_KEY from the local shell
# and sets TEXT_AI_API_KEY on paw-ai; never expose either key in a browser build.
TEXT_AI_BASE_URL=https://api.siliconflow.cn/v1
TEXT_AI_MODEL=Qwen/Qwen2.5-7B-Instruct
